# Pure caches — re-derivable, never committed (spec §3). Anchored to repo root so
# they never shadow source dirs like packages/core/src/logs/.
/workspaces/
/logs/

# Secrets — never committed (spec §5)
.env
.env.*
!.env.example

# Local agent tooling — not part of the project
/.agents/
/.claude/
/skills-lock.json
